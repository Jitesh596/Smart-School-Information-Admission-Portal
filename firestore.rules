rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Applications Collection
    match /applications/{appId} {
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.studentId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Contact Inquiries Collection
    match /contacts/{contactId} {
      allow create: if true; // Any visitor can submit contact form
      allow read, update, delete: if isAdmin();
    }

    // Public School Data Collections
    match /notices/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faculty/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /courses/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /facilities/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /achievements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /schoolInfo/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Student Admission Documents
    match /studentDocuments/{uid}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == uid &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|application/pdf');
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // Public School Images (Gallery, Faculty, Facilities, Events, Achievements)
    match /schoolImages/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAdmin() &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
